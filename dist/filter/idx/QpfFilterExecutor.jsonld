          "memberFieldName": "quadLimit",
          "range": "xsd:number"
        },
        {
          "@id": "derived:dist/filter/idx/QpfFilterExecutor.jsonld#QpfFilterExecutor__member_constructor",
          "memberFieldName": "constructor"
        },
