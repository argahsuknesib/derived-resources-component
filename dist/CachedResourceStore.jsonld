  "@id": "npmd:@solidlab/derived-resources-component",
  "components": [
    {
      "@id": "derived:dist/CachedResourceStore.jsonld#CachedResourceStore",
      "@type": "Class",
      "requireElement": "CachedResourceStore",
      "extends": [
        "css:dist/storage/PassthroughStore.jsonld#PassthroughStore",
        "css:dist/init/cluster/SingleThreaded.jsonld#SingleThreaded"
      ],
      "comment": "A {@link ResourceStore} that caches representation responses. Caching is done using the identifier as key, so this should be at the end of the store chain. after content negotiation, as that results in different representations for the same identifier.  Cache entries are invalidated after any successful write operation. Because of this, this store does not work with worker threads, as the thread invalidating the cache might not be the one that has that cache entry.  Cache settings can be set to determine the max cache entries, or the max size for the entire cache (in bytes). `maxSize` only works for binary data streams.",
      "parameters": [
        {
          "@id": "derived:dist/CachedResourceStore.jsonld#CachedResourceStore_args_source",
          "range": "css:dist/storage/ResourceStore.jsonld#ResourceStore"
        },
        {
          "@id": "derived:dist/CachedResourceStore.jsonld#CachedResourceStore_args_metadataStrategy",
          "range": "css:dist/http/auxiliary/AuxiliaryIdentifierStrategy.jsonld#AuxiliaryIdentifierStrategy"
        },
        {
          "@id": "derived:dist/CachedResourceStore.jsonld#CachedResourceStore_args_cacheSettings_max",
          "range": {
            "@type": "ParameterRangeUnion",
            "parameterRangeElements": [
              "xsd:number",
              {
                "@type": "ParameterRangeUndefined"
              }
            ]
          }
        },
        {
          "@id": "derived:dist/CachedResourceStore.jsonld#CachedResourceStore_args_cacheSettings_maxSize",
          "range": {
            "@type": "ParameterRangeUnion",
            "parameterRangeElements": [
              "xsd:number",
              {
                "@type": "ParameterRangeUndefined"
              }
            ]
          }
        }
      ],
      "memberFields": [
