          "memberFieldName": "isDerivedResource"
        },
        {
          "@id": "derived:dist/DerivedResourceStore.jsonld#DerivedResourceStore__member_getFirstExistingResource",
          "memberFieldName": "getFirstExistingResource"
        },
        {
          "@id": "derived:dist/DerivedResourceStore.jsonld#DerivedResourceStore__member_closeDataStream",
          "memberFieldName": "closeDataStream"
        }
      ],
      "constructorArguments": [
        {
          "@id": "derived:dist/DerivedResourceStore.jsonld#DerivedResourceStore_source"
        },
        {
          "@id": "derived:dist/DerivedResourceStore.jsonld#DerivedResourceStore_manager"
        },
